# Required for answering (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b

# Leave QDRANT_URL empty for embedded local storage in QDRANT_PATH.
# For Qdrant Cloud (free 1 GB cluster) set the URL and API key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data

# Verification policy
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
ENTAIL_THRESHOLD=0.5
CONTRADICT_THRESHOLD=0.5
GROUNDEDNESS_SHOW=0.8
GROUNDEDNESS_REFUSE=0.5
MIN_RERANK_SCORE=-10.0

# Frontend -> backend
API_URL=http://localhost:8000
